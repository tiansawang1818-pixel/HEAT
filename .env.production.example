# Copy to .env.production, chmod 600, and replace all placeholders.
# This file is consumed using --env-file; never commit the populated copy.
HEATSHIFT_DOMAIN=heatshift.example.org
ACME_EMAIL=operator@example.org
POSTGRES_DB=heatshift
POSTGRES_USER=heatshift
POSTGRES_PASSWORD=CHANGE_ME_random_hex_database_password
DATABASE_URL=postgresql+psycopg://heatshift:CHANGE_ME_random_hex_database_password@postgres:5432/heatshift
OIDC_ISSUER=https://identity.example.org
OIDC_AUDIENCE=heatshift-api
OIDC_JWKS_URL=https://identity.example.org/.well-known/jwks.json
OIDC_CLIENT_ID=CHANGE_ME_registered_client_id
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
OIDC_RESOURCE=
OIDC_ROLES_CLAIM=roles
OIDC_ADMIN_ROLES=["heatshift.admin"]
AUTH_SESSION_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
AUTH_REDIS_URL=redis://redis:6379/2
GEE_PROJECT=CHANGE_ME_authorized_project
# Historical processing is opt-in and bounded; never enables a paid provider plan.
HISTORICAL_INGESTION_ENABLED=false
GEE_CREDENTIALS_FILE=./secrets/gee-service-account.json
# Select a licensed tile service suitable for expected production traffic.
# Required at image build time. Its attribution is read from the style metadata.
NEXT_PUBLIC_MAP_STYLE_URL=CHANGE_ME_https_approved_map_style_json
# If this network conflicts with the host, change all three values together.
HEATSHIFT_PROXY_SUBNET=172.30.10.0/24
HEATSHIFT_PROXY_DYNAMIC_RANGE=172.30.10.128/25
HEATSHIFT_PROXY_IP=172.30.10.2
