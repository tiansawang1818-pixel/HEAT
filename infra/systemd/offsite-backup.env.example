# Private server-side file: /etc/heatshift/offsite-backup.env (0600).
# The repository must already be initialized in a separate approved account.
RESTIC_REPOSITORY=s3:https://storage.example.org/separate-heatshift-backups
RESTIC_PASSWORD_FILE=/etc/heatshift/restic-password
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Keep retention/object-lock policies in the storage account. This job never prunes.
