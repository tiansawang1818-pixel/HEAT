# HEAT//SHIFT — copy to .env and replace every CHANGE_ME value.
# Never commit real provider credentials.

# Runtime
APP_ENV=development
ENVIRONMENT=development
DEMO_MODE=true
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=3000
APP_TIMEZONE=Asia/Bangkok
CORS_ORIGINS=["http://localhost:3000"]

# PostgreSQL / PostGIS
POSTGRES_DB=heatshift
POSTGRES_USER=heatshift
# Keep the password embedded in DATABASE_URL identical to POSTGRES_PASSWORD.
POSTGRES_PASSWORD=CHANGE_ME_use_a_long_random_password
DATABASE_URL=postgresql+psycopg://heatshift:CHANGE_ME_use_a_long_random_password@postgres:5432/heatshift
TEST_DATABASE_URL=sqlite+pysqlite:///:memory:

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=false

# Object storage (S3-compatible MinIO in local Compose)
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=ap-southeast-1
S3_BUCKET=heatshift-rasters
S3_ACCESS_KEY=heatshift
S3_SECRET_KEY=CHANGE_ME_minio_secret
MINIO_ROOT_USER=heatshift
# Keep this identical to S3_SECRET_KEY for the local MinIO service.
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_secret

# Admin operations
# Send as X-Admin-Key for POST /api/ingestion/run.
ADMIN_API_KEY=CHANGE_ME_admin_api_key
# Separate operator credential accepted by the Next.js server route; never prefix with NEXT_PUBLIC_.
DASHBOARD_ADMIN_TOKEN=CHANGE_ME_dashboard_operator_token
ALLOW_FIXTURE_INGESTION=false
FIXTURE_ROOT=/workspace/data/fixtures

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
NEXT_PUBLIC_DEMO_MODE=true
API_INTERNAL_URL=http://api:8000

# Google Earth Engine (choose one supported auth method)
GEE_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gee-service-account.json
GEE_SERVICE_ACCOUNT=

# Optional provider configuration
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
WORLDPOP_API_BASE_URL=https://api.worldpop.org/v3
# Optional: anonymous access has lower daily/area limits.
WORLDPOP_API_KEY=
# Leave blank to use the latest available year that is not in the future.
WORLDPOP_REFERENCE_YEAR=
OSM_REPLICATION_STATE_URL=https://planet.openstreetmap.org/replication/day/state.txt
OVERTURE_RELEASE=

# Optional deterministic AI explanations are always available without this key.
OPENAI_API_KEY=

# Provider safety / quota budgets
GEE_MAX_CONCURRENT_EXPORTS=2
HTTP_TIMEOUT_SECONDS=60
SOURCE_REQUEST_TIMEOUT_SECONDS=60
PROVIDER_MAX_RETRIES=5
PROVIDER_BACKOFF_SECONDS=10
