# HEAT//SHIFT — copy to .env and replace every CHANGE_ME value.
# Never commit real provider credentials.

# Runtime
APP_ENV=development
ENVIRONMENT=development
DEMO_MODE=true
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=3000
APP_TIMEZONE=Asia/Bangkok
CORS_ORIGINS=["http://localhost:3000"]

# PostgreSQL / PostGIS
POSTGRES_DB=heatshift
POSTGRES_USER=heatshift
# Keep the password embedded in DATABASE_URL identical to POSTGRES_PASSWORD.
POSTGRES_PASSWORD=CHANGE_ME_use_a_long_random_password
DATABASE_URL=postgresql+psycopg://heatshift:CHANGE_ME_use_a_long_random_password@postgres:5432/heatshift
TEST_DATABASE_URL=sqlite+pysqlite:///:memory:
# Per-process limits; sum pools across all workers/replicas before deploying.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=false

# Object storage (S3-compatible MinIO in local Compose)
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=ap-southeast-1
S3_BUCKET=heatshift-rasters
S3_ACCESS_KEY=heatshift
S3_SECRET_KEY=CHANGE_ME_minio_secret
MINIO_ROOT_USER=heatshift
# Keep this identical to S3_SECRET_KEY for the local MinIO service.
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_secret

# Admin operations
# Send as X-Admin-Key for POST /api/ingestion/run.
ADMIN_API_KEY=CHANGE_ME_admin_api_key
# Development/pilot: local_key. Production is refused unless this is oidc.
ADMIN_AUTH_MODE=local_key
# Required when ADMIN_AUTH_MODE=oidc. Use HTTPS in production.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ROLES_CLAIM=roles
OIDC_ADMIN_ROLES=["heatshift.admin"]
OIDC_ALLOWED_ALGORITHMS=["RS256"]
OIDC_JWKS_CACHE_SECONDS=3600
OIDC_HTTP_TIMEOUT_SECONDS=5
OIDC_CLOCK_SKEW_SECONDS=30
# Register the exact HTTPS /api/auth/callback URI at the identity provider.
APP_ORIGIN=http://localhost:3000
OIDC_CLIENT_ID=
# Confidential clients require a secret. Public PKCE clients leave this blank.
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
# Optional OAuth resource indicator, if supported by the provider.
OIDC_RESOURCE=
# Generate with openssl rand -hex 32. Never expose to the browser.
AUTH_SESSION_SECRET=CHANGE_ME_random_session_encryption_secret
AUTH_REDIS_URL=redis://redis:6379/2
# Distributed limits for expensive/admin POST endpoints. Enable when Redis is available.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_OPTIMIZATION_PER_MINUTE=20
RATE_LIMIT_SCENARIO_PER_MINUTE=30
RATE_LIMIT_FORECAST_PER_MINUTE=6
RATE_LIMIT_ASSISTANT_PER_MINUTE=30
RATE_LIMIT_ADMIN_PER_MINUTE=15
RATE_LIMIT_FAIL_CLOSED_ADMIN=true
# Separate operator credential accepted by the Next.js server route; never prefix with NEXT_PUBLIC_.
DASHBOARD_ADMIN_TOKEN=CHANGE_ME_dashboard_operator_token
ALLOW_FIXTURE_INGESTION=false
FIXTURE_ROOT=/workspace/data/fixtures

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MAP_STYLE_URL=/styles/community-osm.json
NEXT_PUBLIC_DEMO_MODE=true
API_INTERNAL_URL=http://api:8000

# Google Earth Engine (choose one supported auth method)
GEE_PROJECT=
# Enable only after the project owner has verified provider access and quotas.
HISTORICAL_INGESTION_ENABLED=false
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gee-service-account.json
GEE_SERVICE_ACCOUNT=
GEE_TILE_DESCRIPTOR_TTL_SECONDS=3000

# Optional provider configuration
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT_SECONDS=120
OVERPASS_MAX_RESPONSE_BYTES=20000000
OVERPASS_MAX_ELEMENTS=20000
OVERPASS_GRID_DIVISIONS=2
WORLDPOP_API_BASE_URL=https://api.worldpop.org/v3
# Optional: anonymous access has lower daily/area limits.
WORLDPOP_API_KEY=
# Leave blank to use the latest available year that is not in the future.
WORLDPOP_REFERENCE_YEAR=
BMA_BOUNDARY_CATALOG_URL=https://data.go.th/api/3/action/package_show
BMA_BOUNDARY_DATASET_ID=e537025b-1cf6-4c5b-8e46-c2e976f13283
BMA_BOUNDARY_RESOURCE_ID=d7be7e84-9d84-4595-bf8f-79b0bc01f1ae
BMA_BOUNDARY_MAX_DOWNLOAD_BYTES=10000000
OSM_REPLICATION_STATE_URL=https://planet.openstreetmap.org/replication/day/state.txt
OVERTURE_RELEASE=

# Optional deterministic AI explanations are always available without this key.
OPENAI_API_KEY=

# Provider safety / quota budgets
GEE_MAX_CONCURRENT_EXPORTS=2
HTTP_TIMEOUT_SECONDS=60
SOURCE_REQUEST_TIMEOUT_SECONDS=60
PROVIDER_MAX_RETRIES=5
PROVIDER_BACKOFF_SECONDS=10

# Future-outlook scientific publication gates
FORECAST_MIN_YEARS=5
FORECAST_MIN_AREAS=5
FORECAST_MIN_VALIDATION_SAMPLES=20
FORECAST_MIN_BASELINE_IMPROVEMENT=0.0
