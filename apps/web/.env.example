NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional development-only admin token for manual refresh in Data Observatory.
API_INTERNAL_URL=http://api:8000
# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
ADMIN_API_KEY=change-me-to-the-backend-admin-key
DASHBOARD_ADMIN_TOKEN=change-me-to-a-separate-operator-token
ADMIN_AUTH_MODE=local_key
# Production uses oidc and a registered HTTPS /api/auth/callback URI.
APP_ORIGIN=http://localhost:3000
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
OIDC_RESOURCE=
AUTH_SESSION_SECRET=
AUTH_REDIS_URL=redis://localhost:6379/2
